# --- LLM (Nebius Token Factory, OpenAI-compatible) ---
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1     # confirm in the Nebius docs
LLM_API_KEY=                                            # never commit
MODEL_READER=                                           # copy the Nemotron Nano model name from the console
MODEL_WRITER=                                           # Nemotron Super
MODEL_EXAM_EDITS=                                       # Nano or Super for development and the main evaluation; Ultra only for final demo runs
MODEL_SYNTH=                                            # Nano or Super
LLM_MAX_CONCURRENCY=8
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
BUDGET_HARD_LIMIT_USD=20
PRICE_TABLE_PATH=config/prices.json

# --- Storage ---
DB_PATH=data/db/probation.db
WORLD_DB_PATH=data/synth/world.db

# --- Runtime ---
CLOCK_MODE=replay                                        # replay | live
# Application profile is chosen by trusted server configuration, never by the browser or a
# missing token. "synthetic" is the public demonstration identity and unlocks no provider grant.
APP_PROFILE=private                                      # private | synthetic
USER_ADDRESSES=meena@example.test
USER_TZ=Asia/Kolkata
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2       # check fastembed support

# --- Web grounding (Tavily) ---
TAVILY_API_KEY=                                          # never commit
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_MAX_CALLS_PER_DAY=100
TAVILY_MONTHLY_CREDIT_BUDGET=800
USER_NAME_TOKENS=                                        # the user's own name parts, blocked from queries

# --- Files pack ---
FILES_WATCH_DIRS=data/synth/1/fs/Downloads,data/synth/1/fs/Desktop
FILES_ALLOWED_ROOTS=data/synth/1/fs
FILES_READER_ENABLED=false

# --- Tunables: any name from ENGINE_SPEC section 12 may be overridden here ---
# AUDIT_FRACTION=0.10
# L2_MIN_LB=0.95

# --- Gmail Connector (Live Testing & Acceptance) ---
# Explicit operator consent token (REQUIRED to run live tests / live runtime)
PROBATION_GMAIL_LIVE_CONSENT=

# Dedicated Google test account email address
PROBATION_GMAIL_ACCOUNT=

# Google Cloud Console OAuth 2.0 Client ID and Client Secret (Desktop App type)
PROBATION_GMAIL_CLIENT_ID=
PROBATION_GMAIL_CLIENT_SECRET=

# Authorized OAuth Refresh Token with scopes: gmail.readonly, gmail.send, gmail.modify
PROBATION_GMAIL_REFRESH_TOKEN=

# Native Gmail label ID for the synthetic-only cohort (e.g. Label_123), not its display name
PROBATION_GMAIL_LABEL=

# Explicit recipient email address allowlisted for forward actions
PROBATION_FORWARD_ALLOWLIST=

# Local API owner authorization for localhost endpoints. Gmail can be connected later;
# without its private store the dashboard signs in with no Gmail source grants.
# The old PROBATION_OWNER_API_KEY spelling remains accepted for existing local setups.
PROBATION_GMAIL_OWNER_API_KEY=
PROBATION_GMAIL_OWNER_ID=local-owner
PROBATION_GMAIL_STORE=data/private/connectors/gmail_metadata.db
PROBATION_GMAIL_BIND_HOST=127.0.0.1

